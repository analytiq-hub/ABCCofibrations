module

public import Mathlib.CategoryTheory.Localization.CalculusOfFractions
public import Mathlib.CategoryTheory.MorphismProperty.Composition

/-!
# The homotopy category and calculus of fractions (Theorems 5.2.2 and 6.4.1)

Theorem 5.2.2 (Gabriel–Zisman): the localization of a category with weak
equivalences exists, with the same objects, and its maps are generated by the
images of maps and the formal inverses of weak equivalences. This is mathlib's
construction `MorphismProperty.Localization`, a quotient of the category of
zig-zags; we restate its properties.

Theorem 6.4.1 (calculus of left fractions): under the Ore condition and the
cancellation condition, every map of the homotopy category is a left fraction
`s⁻¹f`, two fractions agree iff they become equal after composition with weak
equivalences, and with left cancellable weak equivalences the localization
functor is faithful. Mathlib's `HasLeftCalculusOfFractions` packages the two
conditions; we derive it from the paper's hypotheses and restate the
conclusions in the paper's form.
-/

@[expose] public section

open CategoryTheory Category Localization

namespace ABCCofibrations

variable {C : Type*} [Category C] (W : MorphismProperty C)

/-- **Theorem 5.2.2** (Gabriel–Zisman). The functor `W.Q : C ⥤ W.Localization`
to mathlib's zig-zag category is a localization; it is bijective on objects; and
every map of `W.Localization` is a composite of images of maps of `C` and
inverses of images of weak equivalences (any class of maps containing these and
stable under composition contains all maps). -/
theorem gabrielZisman :
    W.Q.IsLocalization W ∧ Function.Bijective W.Q.obj ∧
      ∀ (P : MorphismProperty W.Localization) [P.IsStableUnderComposition],
        (∀ ⦃X Y : C⦄ (f : X ⟶ Y), P (W.Q.map f)) →
        (∀ ⦃X Y : C⦄ (w : X ⟶ Y) (hw : W w), P (isoOfHom W.Q W w hw).inv) → P = ⊤ := by
  refine ⟨inferInstance, (Construction.objEquiv W).bijective, fun P _ h₁ h₂ ↦ ?_⟩
  refine Construction.morphismProperty_eq_top P h₁ fun X Y w hw ↦ ?_
  have : Construction.wInv w hw = (isoOfHom W.Q W w hw).inv :=
    congrArg Iso.inv (Iso.ext rfl)
  rw [this]
  exact h₂ w hw

/-- The Ore condition (b) and the cancellation condition (c) of Theorem 6.4.1
give a left calculus of fractions. -/
theorem hasLeftCalculusOfFractions_of [W.IsMultiplicative]
    (hb : ∀ ⦃A A' B : C⦄ (a : A ⟶ A') (f : A ⟶ B), W a →
      ∃ (B' : C) (b : B ⟶ B') (g : A' ⟶ B'), W b ∧ f ≫ b = a ≫ g)
    (hc : ∀ ⦃A' A B : C⦄ (s : A' ⟶ A) (f g : A ⟶ B), W s → s ≫ f = s ≫ g →
      ∃ (B' : C) (s' : B ⟶ B'), W s' ∧ f ≫ s' = g ≫ s') :
    W.HasLeftCalculusOfFractions where
  exists_leftFraction X Y φ := by
    obtain ⟨B', b, g, hb', w⟩ := hb φ.s φ.f φ.hs
    exact ⟨MorphismProperty.LeftFraction.mk g b hb', w⟩
  ext X' X Y f₁ f₂ s hs h := by
    obtain ⟨B', s', hs', w⟩ := hc s f₁ f₂ hs h
    exact ⟨B', s', hs', w⟩

variable {D : Type*} [Category D] (L : C ⥤ D) [L.IsLocalization W] [W.HasLeftCalculusOfFractions]

/-- **Theorem 6.4.1(1).** Every map of the homotopy category is a left fraction
`s⁻¹f` with `s` a weak equivalence. -/
theorem exists_leftFraction {A B : C} (φ : L.obj A ⟶ L.obj B) :
    ∃ (B' : C) (f : A ⟶ B') (s : B ⟶ B') (hs : W s),
      φ = L.map f ≫ (isoOfHom L W s hs).inv := by
  obtain ⟨ψ, rfl⟩ := Localization.exists_leftFraction L W φ
  exact ⟨ψ.Y', ψ.f, ψ.s, ψ.hs, rfl⟩

/-- **Theorem 6.4.1(2).** Assuming two out of three, two left fractions `s⁻¹f`
and `t⁻¹g` are equal in the homotopy category iff there are weak equivalences
`s'`, `t'` with `s's = t't` and `s'f = t'g`. -/
theorem leftFraction_eq_iff [W.HasTwoOutOfThreeProperty] {A B B' B'' : C}
    (f : A ⟶ B') (s : B ⟶ B') (hs : W s) (g : A ⟶ B'') (t : B ⟶ B'') (ht : W t) :
    L.map f ≫ (isoOfHom L W s hs).inv = L.map g ≫ (isoOfHom L W t ht).inv ↔
      ∃ (B''' : C) (s' : B' ⟶ B''') (t' : B'' ⟶ B'''), W s' ∧ W t' ∧
        s ≫ s' = t ≫ t' ∧ f ≫ s' = g ≫ t' := by
  have := MorphismProperty.LeftFraction.map_eq_iff L W (MorphismProperty.LeftFraction.mk f s hs)
    (MorphismProperty.LeftFraction.mk g t ht)
  change L.map f ≫ _ = L.map g ≫ _ ↔ _ at this
  refine this.trans ⟨fun ⟨Z, t₁, t₂, hst, hft, hw⟩ ↦ ?_, fun ⟨Z, s', t', hs', ht', h₁, h₂⟩ ↦
    ⟨Z, s', t', h₁, h₂, W.comp_mem _ _ hs hs'⟩⟩
  dsimp at t₁ t₂ hst hft hw
  refine ⟨Z, t₁, t₂, W.of_precomp _ _ hs hw, W.of_precomp _ _ ht (hst ▸ hw), hst, hft⟩

/-- **Theorem 6.4.1(3).** If moreover weak equivalences are left cancellable,
two maps are equal in the homotopy category iff they are equal. -/
theorem map_eq_iff_of_cancel
    (hcancel : ∀ ⦃A B B' : C⦄ (f g : A ⟶ B) (h : B ⟶ B'), W h → f ≫ h = g ≫ h → f = g)
    {A B : C} (f g : A ⟶ B) : L.map f = L.map g ↔ f = g := by
  rw [MorphismProperty.map_eq_iff_postcomp L W]
  exact ⟨fun ⟨_, s, hs, h⟩ ↦ hcancel f g s hs h, fun h ↦ ⟨B, 𝟙 B, W.id_mem B, by rw [h]⟩⟩

end ABCCofibrations
